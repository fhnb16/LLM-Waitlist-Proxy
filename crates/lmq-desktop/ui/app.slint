// Нативное окно LMQ: навигация слева (как NavigationView Windows 11), экраны справа.
// Прозрачный фон окна — под ним Mica или Acrylic, которые ставит Rust.

import { Palette, Button, LineEdit } from "std-widgets.slint";
import { Theme, Glyph } from "theme.slint";
import { UiData, UiActions } from "store.slint";
import { Icon, Badge, Card } from "widgets.slint";
import { OverviewPage } from "overview.slint";
import { QueuePage } from "queue.slint";
import { ModelsPage } from "models.slint";
import { EnginesPage } from "engines.slint";
import { ClientsPage } from "clients.slint";
import { LogsPage } from "logs.slint";
import { SettingsPage } from "settings.slint";

export { Theme, UiData, UiActions }

component NavItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> active;
    in property <bool> compact;
    in property <string> badge;
    in property <string> badge-kind;
    callback clicked;
    height: 36px;
    border-radius: 4px;
    background: active ? Theme.subtle : ta.pressed ? Theme.subtle-2 : ta.has-hover ? Theme.subtle-2 : transparent;
    accessible-role: tab;
    accessible-label: label;
    accessible-item-selected: active;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if active: Rectangle {
        x: 0;
        y: (parent.height - 16px) / 2;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: Theme.accent;
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 14px;
        Icon {
            glyph: root.glyph;
            width: 20px;
        }
        if !compact: Text {
            text: label;
            font-size: 14px;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if !compact && badge != "": VerticalLayout {
            alignment: center;
            Badge { text: badge; kind: badge-kind; }
        }
    }
    if compact && badge != "": Rectangle {
        x: 26px;
        y: 5px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: badge-kind == "bad" ? Theme.danger : Theme.accent;
    }
}

/// Подтверждение действия поверх окна.
component ConfirmDialog inherits Rectangle {
    background: #00000066;
    TouchArea { }
    Card {
        width: min(440px, root.width - 32px);
        height: cbox.preferred-height;
        background: Theme.dark ? #2b2b2b : #ffffff;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;
        cbox := VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Text { text: UiData.confirm-title; font-size: 20px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
            Text { text: UiData.confirm-text; font-size: 14px; color: Theme.text-2; wrap: word-wrap; }
            HorizontalLayout {
                padding-top: 12px;
                spacing: 8px;
                Button {
                    horizontal-stretch: 1;
                    text: UiData.confirm-ok;
                    primary: true;
                    clicked => { UiActions.confirm-accept(); }
                }
                Button {
                    horizontal-stretch: 1;
                    text: @tr("Отмена");
                    clicked => { UiActions.confirm-dismiss(); }
                }
            }
        }
    }
}

/// Секрет, показанный один раз (ключ клиента).
component SecretDialog inherits Rectangle {
    background: #00000066;
    TouchArea { }
    Card {
        width: min(520px, root.width - 32px);
        height: sbox.preferred-height;
        background: Theme.dark ? #2b2b2b : #ffffff;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;
        sbox := VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Text { text: UiData.secret-title; font-size: 20px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
            Text { text: UiData.secret-text; font-size: 14px; color: Theme.text-2; wrap: word-wrap; }
            LineEdit {
                text: UiData.secret-value;
                read-only: true;
                font-size: 13px;
            }
            HorizontalLayout {
                padding-top: 12px;
                spacing: 8px;
                Button {
                    horizontal-stretch: 1;
                    text: @tr("Копировать");
                    primary: true;
                    clicked => { UiActions.copy(UiData.secret-value); }
                }
                Button {
                    horizontal-stretch: 1;
                    text: @tr("Готово");
                    clicked => { UiActions.secret-dismiss(); }
                }
            }
        }
    }
}

/// Короткое сообщение внизу окна. Сам компонент прозрачен и растянут на всё окно.
component Toast inherits Rectangle {
    Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 24px;
        width: min(root.width - 32px, ttext.preferred-width + 40px);
        height: ttext.preferred-height + 22px;
        border-radius: 8px;
        background: Theme.dark ? #2c2c2c : #ffffff;
        border-width: 1px;
        border-color: UiData.toast-kind == "bad" ? Theme.danger : UiData.toast-kind == "ok" ? Theme.ok : Theme.stroke;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000040;
        ttext := Text {
            x: 20px;
            width: parent.width - 40px;
            text: UiData.toast;
            font-size: 13px;
            color: Theme.text;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    in property <bool> dark;
    in property <bool> solid;
    in property <int> queued;
    in property <int> dead;
    // Ширина панели навигации влияет на минимальную ширину окна, поэтому режим
    // переключается по событию, а не привязкой (иначе — цикл привязок).
    property <bool> compact: false;
    changed width => {
        compact = self.width < 900px;
    }

    title: "LMQ";
    icon: @image-url("../icons/32x32.png");
    min-width: 400px;
    min-height: 500px;
    preferred-width: 1240px;
    preferred-height: 820px;
    default-font-family: "Segoe UI";
    background: Theme.solid ? Theme.window-solid : transparent;

    init => {
        Theme.dark = dark;
        Theme.solid = solid;
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark => {
        Theme.dark = dark;
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed solid => {
        Theme.solid = solid;
    }

    HorizontalLayout {
        // Панель навигации.
        VerticalLayout {
            width: compact ? 56px : 264px;
            padding: 6px;
            padding-top: 10px;
            spacing: 4px;
            HorizontalLayout {
                height: 44px;
                padding-left: 12px;
                spacing: 12px;
                Image {
                    source: @image-url("../icons/128x128.png");
                    width: 22px;
                    height: 22px;
                    y: (parent.height - 22px) / 2;
                }
                if !compact: Text {
                    text: "LMQ";
                    font-size: 15px;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                if !compact: Text {
                    text: UiData.version;
                    font-size: 12px;
                    color: Theme.text-3;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
            NavItem { glyph: Glyph.home; label: @tr("Обзор"); compact: compact; active: UiData.page == 0; clicked => { UiActions.navigate(0); } }
            NavItem { glyph: Glyph.queue; label: @tr("Очередь"); compact: compact; active: UiData.page == 1;
                badge: dead > 0 ? "\{dead}" : queued > 0 ? "\{queued}" : "";
                badge-kind: dead > 0 ? "bad" : "";
                clicked => { UiActions.navigate(1); } }
            NavItem { glyph: Glyph.models; label: @tr("Модели"); compact: compact; active: UiData.page == 2; clicked => { UiActions.navigate(2); } }
            NavItem { glyph: Glyph.engines; label: @tr("Движки"); compact: compact; active: UiData.page == 3; clicked => { UiActions.navigate(3); } }
            NavItem { glyph: Glyph.clients; label: @tr("Клиенты"); compact: compact; active: UiData.page == 4; clicked => { UiActions.navigate(4); } }
            NavItem { glyph: Glyph.logs; label: @tr("Журнал"); compact: compact; active: UiData.page == 5; clicked => { UiActions.navigate(5); } }
            Rectangle { vertical-stretch: 1; }
            NavItem { glyph: Glyph.globe; label: @tr("Панель в браузере"); compact: compact; clicked => { UiActions.open-panel(""); } }
            NavItem { glyph: Glyph.settings; label: @tr("Настройки"); compact: compact; active: UiData.page == 6; clicked => { UiActions.navigate(6); } }
        }
        // Слой содержимого: чуть светлее подложки, скруглённый верхний левый угол.
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.solid ? (Theme.dark ? #272727 : #f9f9f9) : (Theme.dark ? #ffffff08 : #ffffff80);
            border-top-left-radius: 8px;
            border-width: 1px;
            border-color: Theme.stroke;
            clip: true;
            if UiData.page == 0: OverviewPage { }
            if UiData.page == 1: QueuePage { }
            if UiData.page == 2: ModelsPage { }
            if UiData.page == 3: EnginesPage { }
            if UiData.page == 4: ClientsPage { }
            if UiData.page == 5: LogsPage { }
            if UiData.page == 6: SettingsPage { }
        }
    }

    // Окна и сообщение — компонентами без дочерних элементов: текст с переносом внутри
    // `if` иначе получает высоту одной строки (tests/slint_layout.rs).
    if UiData.confirm-title != "": ConfirmDialog { }
    if UiData.secret-title != "": SecretDialog { }
    if UiData.toast != "": Toast { }
}
