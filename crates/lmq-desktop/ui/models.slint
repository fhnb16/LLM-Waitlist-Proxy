import { ScrollView, Button, Switch } from "std-widgets.slint";
import { Theme, Glyph } from "theme.slint";
import { UiData, UiActions } from "store.slint";
import { Card, PageHeader, SectionTitle, ListRow, Slots, StatusChip, Divider, Dot } from "widgets.slint";

export component ModelsPage inherits Rectangle {
    sv := ScrollView {
        content-width: self.visible-width;
        content-height: content.preferred-height;
        content := VerticalLayout {
            width: sv.visible-width;
            padding: 28px;
            padding-top: 20px;
            spacing: 16px;
            PageHeader {
                title: @tr("Модели");
                subtitle: @tr("Таблица моделей, апстримы, слоты и здоровье");
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: @tr("Изменить в панели");
                        clicked => { UiActions.open-panel("#/models"); }
                    }
                }
            }
            for m in UiData.models: Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Dot { kind: m.kind; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            SectionTitle { text: m.name; }
                            Text {
                                text: m.state + (m.description != "" ? " · " + m.description : "");
                                font-size: 12px;
                                color: Theme.text-2;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                text: @tr("Включена");
                                checked: m.enabled;
                                toggled => { UiActions.model-toggle(m.name, self.checked); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: m.testing ? @tr("Проверка…") : @tr("Проверить");
                                enabled: !m.testing && m.enabled;
                                clicked => { UiActions.model-test(m.name); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        Text {
                            text: @tr("очередь {}", m.queued) + " · " + @tr("выполняется {}", m.running) + " · " + @tr("слотов {}", m.slots);
                            font-size: 13px;
                            color: Theme.text-2;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Slots { total: m.slots; busy: m.busy; }
                    }
                    if m.aliases != "" || m.fallback != "": Text {
                        text: (m.aliases != "" ? @tr("алиасы: {}", m.aliases) : "") + (m.aliases != "" && m.fallback != "" ? " · " : "") + (m.fallback != "" ? @tr("резерв: {}", m.fallback) : "");
                        font-size: 12px;
                        color: Theme.text-3;
                        wrap: word-wrap;
                    }
                    if m.test != "": Rectangle {
                        border-radius: 6px;
                        background: Theme.subtle-2;
                        HorizontalLayout {
                            padding: 10px;
                            Text {
                                text: m.test;
                                font-size: 12px;
                                color: Theme.text;
                                wrap: word-wrap;
                            }
                        }
                    }
                    Divider { }
                    for u[i] in m.upstreams: ListRow {
                        title: u.id;
                        sub: u.url + (u.error != "" ? " · " + u.error : "");
                        dot: u.kind;
                        min-height: 44px;
                        VerticalLayout {
                            alignment: center;
                            StatusChip { kind: u.kind; label: u.state; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Slots { total: u.slots; busy: u.busy; }
                        }
                    }
                }
            }
            if UiData.models.length == 0: Card {
                height: 120px;
                VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    Text {
                        text: @tr("Моделей нет");
                        font-size: 14px;
                        color: Theme.text-2;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        Button {
                            text: @tr("Добавить модель");
                            primary: true;
                            clicked => { UiActions.open-panel("#/models?new=1"); }
                        }
                    }
                }
            }
        }
    }
}
