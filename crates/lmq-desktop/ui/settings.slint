import { ScrollView, Button, LineEdit, Switch, ComboBox } from "std-widgets.slint";
import { Theme, Glyph } from "theme.slint";
import { UiData, UiActions } from "store.slint";
import { Card, PageHeader, SectionTitle, Segmented, Divider, Icon, Banner, ComboEdit, NumberEdit } from "widgets.slint";
import { FieldRow } from "types.slint";

/// Строка настройки: подпись и подсказка слева, элемент управления справа.
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> locked;
    in property <bool> stack;
    min-height: stack ? 0 : 56px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: stack ? 10px : 8px;
        padding-bottom: stack ? 6px : 8px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text { text: label; font-size: 14px; color: Theme.text; wrap: word-wrap; }
            if hint != "" || locked: Text {
                text: locked ? @tr("Задано в окружении — меняется там") : hint;
                font-size: 12px;
                color: locked ? Theme.warn : Theme.text-3;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            alignment: end;
            @children
        }
    }
}

component FieldEditor inherits VerticalLayout {
    in property <FieldRow> f;
    in property <int> index;
    in property <bool> narrow;
    if f.kind == "header": HorizontalLayout {
        padding-left: 16px;
        padding-top: 18px;
        padding-bottom: 6px;
        SectionTitle { text: f.label; }
    }
    if f.kind == "note": HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-bottom: 6px;
        Text { text: f.label; font-size: 12px; color: Theme.text-2; wrap: word-wrap; }
    }
    if f.kind == "bool": SettingRow {
        label: f.label;
        hint: f.hint;
        locked: f.locked;
        VerticalLayout {
            alignment: center;
            Switch {
                checked: f.checked;
                enabled: !f.locked;
                toggled => { UiActions.field-bool(index, self.checked); }
            }
        }
    }
    if f.kind == "select": SettingRow {
        label: f.label;
        hint: f.hint;
        locked: f.locked;
        VerticalLayout {
            alignment: center;
            ComboBox {
                min-width: 160px;
                model: f.options;
                current-index: f.index;
                enabled: !f.locked;
                selected => { UiActions.field-select(index, self.current-index); }
            }
        }
    }
    // Справа на широком окне, под подписью — на узком.
    if (f.kind == "text" || f.kind == "secret" || f.kind == "number" || f.kind == "combo") && !narrow: SettingRow {
        label: f.label;
        hint: f.hint;
        locked: f.locked;
        VerticalLayout {
            alignment: center;
            if f.kind == "text" || f.kind == "secret": LineEdit {
                width: 300px;
                text: f.value;
                enabled: !f.locked;
                placeholder-text: f.placeholder;
                input-type: f.kind == "secret" ? InputType.password : InputType.text;
                edited(t) => { UiActions.field-text(index, t); }
            }
            if f.kind == "number": NumberEdit {
                width: 260px;
                text: f.value;
                values: f.options;
                labels: f.labels;
                hints: f.hints;
                minimum: f.minimum;
                maximum: f.maximum;
                placeholder: f.placeholder;
                enabled: !f.locked;
                edited(t) => { UiActions.field-text(index, t); }
            }
            if f.kind == "combo": ComboEdit {
                width: 300px;
                text: f.value;
                values: f.options;
                labels: f.labels;
                hints: f.hints;
                placeholder: f.placeholder;
                enabled: !f.locked;
                edited(t) => { UiActions.field-text(index, t); }
            }
        }
    }
    if (f.kind == "text" || f.kind == "secret" || f.kind == "number" || f.kind == "combo") && narrow: VerticalLayout {
        SettingRow {
            label: f.label;
            hint: f.hint;
            locked: f.locked;
            stack: true;
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 10px;
            if f.kind == "text" || f.kind == "secret": LineEdit {
                text: f.value;
                enabled: !f.locked;
                placeholder-text: f.placeholder;
                input-type: f.kind == "secret" ? InputType.password : InputType.text;
                edited(t) => { UiActions.field-text(index, t); }
            }
            if f.kind == "number": NumberEdit {
                text: f.value;
                values: f.options;
                labels: f.labels;
                hints: f.hints;
                minimum: f.minimum;
                maximum: f.maximum;
                placeholder: f.placeholder;
                enabled: !f.locked;
                edited(t) => { UiActions.field-text(index, t); }
            }
            if f.kind == "combo": ComboEdit {
                text: f.value;
                values: f.options;
                labels: f.labels;
                hints: f.hints;
                placeholder: f.placeholder;
                enabled: !f.locked;
                edited(t) => { UiActions.field-text(index, t); }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    property <bool> narrow: self.width < 720px;
    sv := ScrollView {
        content-width: self.visible-width;
        content-height: content.preferred-height;
        content := VerticalLayout {
            width: sv.visible-width;
            padding: 28px;
            padding-top: 20px;
            spacing: 16px;
            PageHeader {
                title: @tr("Настройки");
                subtitle: UiData.settings-file;
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: @tr("Полная панель");
                        clicked => { UiActions.open-panel("#/settings"); }
                    }
                }
            }

            // Вкладки: 0 — сервер, 1 — сеть, 2 — Telegram, 3 — журнал, 4 — приложение.
            // Поля вкладки (`UiData.fields`) подставляет Rust по `settings-tab-selected`.
            Segmented {
                max-width: 640px;
                items: [@tr("Сервер"), @tr("Сеть"), "Telegram", @tr("Журнал"), @tr("Приложение")];
                current <=> UiData.settings-tab;
                selected(i) => { UiActions.settings-tab-selected(i); }
            }

            if UiData.settings-tab == 4: SectionTitle { text: @tr("Оформление"); }
            if UiData.settings-tab == 4: Card {
                VerticalLayout {
                    SettingRow {
                        label: @tr("Тема");
                        hint: @tr("Светлая, тёмная или как в Windows");
                        stack: narrow;
                        if !narrow: Segmented {
                            width: 300px;
                            items: [@tr("Системная"), @tr("Светлая"), @tr("Тёмная")];
                            current <=> UiData.scheme;
                            selected(i) => { UiActions.set-scheme(i); }
                        }
                    }
                    if narrow: HorizontalLayout {
                        padding: 16px;
                        padding-top: 0;
                        Segmented {
                            items: [@tr("Системная"), @tr("Светлая"), @tr("Тёмная")];
                            current <=> UiData.scheme;
                            selected(i) => { UiActions.set-scheme(i); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        label: @tr("Фон окна");
                        hint: UiData.mica-available ? @tr("Mica — Windows 11, Acrylic — Windows 10 и 11") : @tr("Mica доступна в Windows 11; здесь будет Acrylic");
                        stack: narrow;
                        if !narrow: Segmented {
                            width: 300px;
                            items: ["Mica", "Acrylic", @tr("Без размытия")];
                            current <=> UiData.backdrop;
                            selected(i) => { UiActions.set-backdrop(i); }
                        }
                    }
                    if narrow: HorizontalLayout {
                        padding: 16px;
                        padding-top: 0;
                        Segmented {
                            items: ["Mica", "Acrylic", @tr("Без размытия")];
                            current <=> UiData.backdrop;
                            selected(i) => { UiActions.set-backdrop(i); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        label: @tr("Язык");
                        hint: @tr("Интерфейс окна и веб-панели");
                        VerticalLayout {
                            alignment: center;
                            ComboBox {
                                min-width: 160px;
                                model: [@tr("Как в системе"), "Русский", "English"];
                                current-index <=> UiData.language;
                                selected => { UiActions.set-language(self.current-index); }
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        label: @tr("Веб-режим окна");
                        hint: @tr("WebView2: 26 тем оформления, полная панель. Приложение перезапустится.");
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: @tr("Перейти");
                                clicked => { UiActions.switch-to-web(); }
                            }
                        }
                    }
                }
            }

            if UiData.settings-tab == 4: SectionTitle { text: @tr("Приложение"); }
            if UiData.settings-tab == 4: Card {
                VerticalLayout {
                    SettingRow {
                        label: @tr("Запускать при входе в Windows");
                        hint: @tr("Сразу в трей, без окна");
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                checked <=> UiData.autostart;
                                toggled => { UiActions.set-app-flag("autostart", self.checked); }
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        label: @tr("Запускать свёрнутым");
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                checked <=> UiData.start-minimized;
                                toggled => { UiActions.set-app-flag("start_minimized", self.checked); }
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        label: @tr("Закрывать в трей");
                        hint: @tr("Сервер продолжает работать; выход — из меню значка");
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                checked <=> UiData.close-to-tray;
                                toggled => { UiActions.set-app-flag("close_to_tray", self.checked); }
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        label: @tr("Уведомления Windows");
                        hint: @tr("Апстрим исключён или вернулся, задание не доставлено, движок упал");
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                checked <=> UiData.notifications;
                                toggled => { UiActions.set-app-flag("notifications", self.checked); }
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        label: @tr("Сразу выдавать задания моделям");
                        hint: @tr("Иначе приложение стартует с выдачей на паузе");
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                checked <=> UiData.server-autostart;
                                toggled => { UiActions.set-app-flag("server_autostart", self.checked); }
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        label: @tr("Папки");
                        hint: UiData.config-dir;
                        stack: narrow;
                        if !narrow: HorizontalLayout {
                            spacing: 8px;
                            Button { text: @tr("Настройки"); clicked => { UiActions.open-folder("config"); } }
                            Button { text: @tr("Данные"); clicked => { UiActions.open-folder("data"); } }
                            Button { text: @tr("Журналы"); clicked => { UiActions.open-folder("logs"); } }
                        }
                    }
                    if narrow: HorizontalLayout {
                        padding: 16px;
                        padding-top: 0;
                        spacing: 8px;
                        Button { text: @tr("Настройки"); clicked => { UiActions.open-folder("config"); } }
                        Button { text: @tr("Данные"); clicked => { UiActions.open-folder("data"); } }
                        Button { text: @tr("Журналы"); clicked => { UiActions.open-folder("logs"); } }
                    }
                }
            }

            if UiData.settings-tab < 4: HorizontalLayout {
                spacing: 12px;
                SectionTitle {
                    text: @tr("Сервер очереди");
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                if UiData.settings-dirty: Button {
                    text: @tr("Отменить");
                    clicked => { UiActions.settings-revert(); }
                }
                Button {
                    text: @tr("Сохранить");
                    primary: true;
                    enabled: UiData.settings-dirty;
                    clicked => { UiActions.settings-save(); }
                }
            }
            if UiData.settings-tab < 4 && UiData.settings-error != "": Banner {
                kind: "bad";
                title: @tr("Настройки не сохранены");
                text: UiData.settings-error;
            }
            if UiData.settings-tab < 4: Card {
                VerticalLayout {
                    padding-bottom: 8px;
                    // Только поля текущей вкладки; правки идут в черновик по `f.def`.
                    for f in UiData.fields: FieldEditor {
                        f: f;
                        index: f.def;
                        narrow: narrow;
                    }
                }
            }

            if UiData.settings-tab == 1: Card {
                VerticalLayout {
                    SettingRow {
                        label: @tr("Проверить маршруты");
                        hint: @tr("Бот, каждый апстрим и Telegram: DNS, соединение, HTTP и внешний IP. Запросы — GET без данных.");
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: UiData.netcheck-running ? @tr("Проверяю…") : @tr("Проверить");
                                enabled: !UiData.netcheck-running;
                                clicked => { UiActions.netcheck(); }
                            }
                        }
                    }
                    if UiData.netcheck != "": HorizontalLayout {
                        padding: 16px;
                        padding-top: 0;
                        Text {
                            text: UiData.netcheck;
                            font-size: 12px;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if UiData.settings-tab == 2: Card {
                VerticalLayout {
                    SettingRow {
                        label: @tr("Проверить реле Telegram");
                        hint: @tr("Маршрут до Telegram, ответ Bot API по нему и путь через адрес API LMQ. Проверка с токеном бота — в веб-панели.");
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: UiData.tgcheck-running ? @tr("Проверяю…") : @tr("Проверить");
                                enabled: !UiData.tgcheck-running;
                                clicked => { UiActions.tgcheck(); }
                            }
                        }
                    }
                    if UiData.tgcheck != "": HorizontalLayout {
                        padding: 16px;
                        padding-top: 0;
                        Text {
                            text: UiData.tgcheck;
                            font-size: 12px;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if UiData.settings-tab == 1: SectionTitle { text: @tr("SOCKS5-прокси: ссылки"); }
            if UiData.settings-tab == 1: Card {
                VerticalLayout {
                    // Без `if` внутри `for` (см. поля): у первой строки разделитель просто прозрачный.
                    for l[i] in UiData.socks-links: VerticalLayout {
                        Divider { opacity: i > 0 ? 1 : 0; }
                        SettingRow {
                            label: l.title;
                            hint: l.host;
                            // Кнопки — по центру строки, как в остальных строках: иначе
                            // они растягиваются по высоте и наползают на рамку карточки.
                            VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "socks5h";
                                        clicked => { UiActions.copy(l.url); }
                                    }
                                    Button {
                                        text: "Telegram";
                                        clicked => { UiActions.copy(l.telegram); }
                                    }
                                }
                            }
                        }
                    }
                    if UiData.socks-note != "": HorizontalLayout {
                        padding: 16px;
                        padding-top: 4px;
                        Text {
                            text: UiData.socks-note + " " + @tr("Ссылки содержат логин и пароль. Снаружи прокси доступен, если на роутере проброшен порт.");
                            font-size: 12px;
                            color: Theme.text-2;
                            wrap: word-wrap;
                        }
                    }
                    Divider { }
                    SettingRow {
                        label: @tr("Проверить прокси");
                        hint: @tr("Соединение через прокси и внешний IP — в сравнении с выбранным интерфейсом напрямую и с системным маршрутом.");
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: @tr("Обновить IP");
                                    clicked => { UiActions.socks-refresh(); }
                                }
                                Button {
                                    text: UiData.sockscheck-running ? @tr("Проверяю…") : @tr("Проверить");
                                    enabled: !UiData.sockscheck-running;
                                    clicked => { UiActions.sockscheck(); }
                                }
                            }
                        }
                    }
                    if UiData.sockscheck != "": HorizontalLayout {
                        padding: 16px;
                        padding-top: 0;
                        Text {
                            text: UiData.sockscheck;
                            font-size: 12px;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if UiData.settings-tab == 4: SectionTitle { text: @tr("Обновления и о программе"); }
            if UiData.settings-tab == 4: Card {
                VerticalLayout {
                    SettingRow {
                        label: "LMQ " + UiData.version;
                        hint: UiData.update-status;
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: @tr("Проверить обновления");
                                clicked => { UiActions.check-updates(); }
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        label: @tr("Проверять при запуске");
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                checked <=> UiData.update-auto;
                                toggled => { UiActions.set-app-flag("updates_auto", self.checked); }
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        label: @tr("Расписание, профили, песочница, отладка колбэков");
                        hint: @tr("Открываются в полной панели в браузере");
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: @tr("Открыть");
                                clicked => { UiActions.open-panel("#/settings"); }
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        label: @tr("Выйти из LMQ");
                        hint: @tr("Останавливает сервер очереди и движки");
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: @tr("Выход");
                                clicked => { UiActions.quit(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
