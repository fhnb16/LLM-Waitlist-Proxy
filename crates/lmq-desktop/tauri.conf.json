{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LMQ",
  "mainBinaryName": "LMQ",
  "identifier": "dev.lmq.desktop",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "LMQ contributors",
    "category": "DeveloperTool",
    "shortDescription": "Queue server for UniversalBot",
    "longDescription": "LMQ: очередь заданий между ботом UniversalBot и локальными моделями (llama.cpp, vLLM, Ollama).",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
